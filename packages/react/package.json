{
  "name": "@fluent/react",
  "version": "0.1.0",
  "description": "Privy + ZeroDev React integration for Fluent Connect",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/fluent-react.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:css",
    "build:js": "tsup src/index.ts --format esm --dts --clean --external react --external @privy-io/react-auth --external @zerodev/sdk --external @zerodev/ecdsa-validator --external @zerodev/permissions --external @reown/appkit --external @reown/appkit-adapter-wagmi --external @swapper-finance/deposit-sdk --external @tanstack/react-query --external wagmi --external viem --external radix-ui --external @base-ui/react --external lucide-react",
    "build:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/fluent-react.css --minify",
    "dev:css": "tailwindcss -i ./src/styles/globals.css -o ./dist/fluent-react.css --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fluent/chains": "workspace:*",
    "@fluent/connect-sdk": "workspace:*",
    "@fluent/registry": "workspace:*",
    "@fluent/wallet-sdk": "workspace:*",
    "@privy-io/react-auth": "^2.21.0",
    "@reown/appkit": "1.8.20",
    "@reown/appkit-adapter-wagmi": "1.8.20",
    "@swapper-finance/deposit-sdk": "^0.2.12",
    "@tanstack/react-query": "^5.90.11",
    "@zerodev/ecdsa-validator": "^5.4.5",
    "@zerodev/permissions": "^5.6.3",
    "@zerodev/sdk": "^5.5.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "radix-ui": "^1.6.2",
    "tailwind-merge": "^3.6.0",
    "viem": "^2.31.0",
    "wagmi": "^2.19.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@fluent/connect-sdk": "workspace:*",
    "@fluent/wallet-sdk": "workspace:*",
    "@privy-io/react-auth": "^2.21.0",
    "@reown/appkit": "1.8.20",
    "@reown/appkit-adapter-wagmi": "1.8.20",
    "@swapper-finance/deposit-sdk": "^0.2.12",
    "@tailwindcss/cli": "^4.3.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/react": "^18.3.23",
    "@zerodev/ecdsa-validator": "^5.4.5",
    "@zerodev/permissions": "^5.6.3",
    "@zerodev/sdk": "^5.5.10",
    "react": "^18.3.1",
    "tailwindcss": "^4.3.2",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.3",
    "viem": "^2.31.0",
    "vitest": "^3.2.1",
    "wagmi": "^2.19.0"
  }
}
