{
  "name": "@fluent/react",
  "version": "0.1.0",
  "description": "Privy + ZeroDev React integration for Fluent Connect",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --external react --external @privy-io/react-auth --external @zerodev/sdk --external @zerodev/ecdsa-validator --external viem",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fluent/chains": "workspace:*",
    "@fluent/registry": "workspace:*"
  },
  "peerDependencies": {
    "@privy-io/react-auth": ">=2.0.0",
    "@zerodev/ecdsa-validator": ">=5.0.0",
    "@zerodev/sdk": ">=5.0.0",
    "react": ">=18.0.0",
    "viem": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@privy-io/react-auth": {
      "optional": false
    }
  },
  "devDependencies": {
    "@privy-io/react-auth": "^2.21.0",
    "@types/react": "^18.3.23",
    "@zerodev/ecdsa-validator": "^5.4.5",
    "@zerodev/sdk": "^5.5.10",
    "react": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "viem": "^2.31.0",
    "vitest": "^3.2.1"
  }
}
