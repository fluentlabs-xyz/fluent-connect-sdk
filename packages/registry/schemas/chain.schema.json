{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FluentChain",
  "type": "object",
  "required": ["id", "name", "chainId", "testnet", "nativeCurrency", "rpcUrls", "blockExplorers", "infoURL"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "chainId": { "type": "integer", "minimum": 1 },
    "testnet": { "type": "boolean" },
    "nativeCurrency": {
      "type": "object",
      "required": ["name", "symbol", "decimals"],
      "properties": {
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "decimals": { "type": "integer" }
      }
    },
    "rpcUrls": { "type": "object" },
    "blockExplorers": { "type": "object" },
    "infoURL": { "type": "string", "format": "uri" },
    "parent": { "type": "object" },
    "contracts": { "type": "object" }
  }
}
