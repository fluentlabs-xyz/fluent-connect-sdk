      "roundness": null,
      "seed": 1009,
      "version": 1,
      "versionNonce": 2009,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Explorer\n\nDescription\nOpen the Fluent smart account in the explorer.\n\nProblem it solves\nUsers and builders need transparent account state.\n\nCurrent issues\nMust never open signer address by mistake.\n\nTODOs\nAdd copy address, tx links, and account readiness states.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Explorer\n\nDescription\nOpen the Fluent smart account in the explorer.\n\nProblem it solves\nUsers and builders need transparent account state.\n\nCurrent issues\nMust never open signer address by mistake.\n\nTODOs\nAdd copy address, tx links, and account readiness states.",
      "lineHeight": 1.18,
      "baseline": 249
    },
