    {
      "id": "explorer-text",
      "type": "text",
      "x": 662,
      "y": 214,
      "width": 218,
      "height": 255,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
