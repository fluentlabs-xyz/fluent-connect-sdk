    {
      "id": "faucet-text",
      "type": "text",
      "x": 92,
      "y": 214,
      "width": 218,
      "height": 255,
      "angle": 0,
      "strokeColor": "#134e4a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1005,
      "version": 1,
      "versionNonce": 2005,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Faucet\n\nDescription\nClaim starter BLEND for Fluent usage.\n\nProblem it solves\nNew users cannot try apps with an empty account.\n\nCurrent issues\nFunding must target the smart account, not the Privy signer.\n\nTODOs\nRoute via SDK service, enforce scopes, rate limits, and app policy.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Faucet\n\nDescription\nClaim starter BLEND for Fluent usage.\n\nProblem it solves\nNew users cannot try apps with an empty account.\n\nCurrent issues\nFunding must target the smart account, not the Privy signer.\n\nTODOs\nRoute via SDK service, enforce scopes, rate limits, and app policy.",
      "lineHeight": 1.18,
      "baseline": 249
    },
