{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      // Biome would re-pad Markdown tables, and packages/connect/docs/api.md is generated and
      // compared byte for byte by a test.
      "!**/*.md",
      // pnpm writes the lockfile, and rewrites it on the next install.
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": {
    "actions": {
      "source": {
        // Sorting imports changes ESM evaluation order.
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    // Each rule set to "warn" below is recommended and found errors when Biome was adopted; it
    // warns until a follow-up fixes those errors by hand and returns it to "error".
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "warn", // a11y: the fix changes markup users see
        "noLabelWithoutControl": "warn", // a11y: the fix changes markup users see
        "noStaticElementInteractions": "warn", // a11y: the fix changes markup users see
        "noSvgWithoutTitle": "warn", // a11y: the fix changes markup users see
        "useAnchorContent": "warn", // a11y: the fix changes markup users see
        "useAriaPropsSupportedByRole": "warn", // a11y: the fix changes markup users see
        "useButtonType": "warn", // a11y: the fix changes markup users see and form submission
        "useSemanticElements": "warn" // a11y: the fix changes markup users see
      },
      "correctness": {
        "noChildrenProp": "warn", // React: the fix changes how a component renders
        "noComponentHookFactories": "warn", // React: the fix changes render and hook timing
        "useExhaustiveDependencies": "warn", // React: the fix changes when an effect runs
        "useHookAtTopLevel": "warn", // React: the fix changes hook call order
        "noMissingVarFunction": "warn", // CSS: the fix changes the value the browser applies
        "noUnsafeOptionalChaining": "warn" // logic: the fix changes a runtime value
      },
      "suspicious": {
        "noArrayIndexKey": "warn", // React: the fix changes which element React reuses
        "noAssignInExpressions": "warn", // logic: the fix changes a runtime value
        "noControlCharactersInRegex": "warn", // logic: the fix changes what a regex matches
        "noDoubleEquals": "warn", // logic: the fix changes a comparison's result
        "noDuplicateObjectKeys": "warn", // logic: the fix changes which value an object holds
        "noImplicitAnyLet": "warn", // logic: the fix needs the variable's real type
        "useIterableCallbackReturn": "warn", // logic: the fix changes a callback's result
        "noShorthandPropertyOverrides": "warn" // CSS: the fix changes the value the browser applies
      }
    }
  }
}
