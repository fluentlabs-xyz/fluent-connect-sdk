{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      // Biome would re-pad Markdown tables, and packages/connect/docs/api.md is generated and
      // compared byte for byte by a test.
      "!**/*.md",
      // pnpm writes the lockfile, and rewrites it on the next install.
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "assist": {
    "actions": {
      "source": {
        // Sorting imports changes ESM evaluation order.
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    // Each rule set to "warn" below is recommended and found errors when Biome was adopted; it
    // warns until a follow-up fixes those errors by hand and returns it to "error".
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noChildrenProp": "warn", // React: the fix changes how a component renders
        "noComponentHookFactories": "warn", // React: the fix changes render and hook timing
        "useExhaustiveDependencies": "warn", // React: the fix changes when an effect runs
        "useHookAtTopLevel": "warn" // React: the fix changes hook call order
      },
      "style": {
        "noNonNullAssertion": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "warn", // React: the fix changes which element React reuses
        // Variables turbo need not hash. The GitHub Actions runner sets GITHUB_OUTPUT for
        // scripts/release/release.ts, which the release workflow runs with node, not turbo. The
        // package manager sets npm_lifecycle_event to the running script's name, which the turbo
        // task already fixes. Vite sets import.meta.env.DEV from its own mode, not from the
        // environment. FLUENT_KERNEL_SIGNATURE_TEST and FLUENT_KERNEL_SIGNATURE_FORK_URL opt into
        // the fork test, which skips without them and runs through the test:kernel-signature
        // script, not a turbo task.
        "noUndeclaredEnvVars": {
          "level": "on",
          "options": {
            "allowedEnvVars": [
              "GITHUB_OUTPUT",
              "npm_lifecycle_event",
              "DEV",
              "FLUENT_KERNEL_SIGNATURE_TEST",
              "FLUENT_KERNEL_SIGNATURE_FORK_URL"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      // The file overrides the CSS of Privy's login modal, markup the widget does not own, where only an !important wins.
      "includes": ["packages/connect/src/styles/privy-theme.css"],
      "linter": {
        "rules": {
          "complexity": { "noImportantStyles": "off" },
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    },
    {
      // A `!` on a missing value in a test throws, and a failing `!` fails the test.
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs", "**/test/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    }
  ]
}
