{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@fluent.xyz/connect-sdk": ["../../packages/connect-sdk/src/index.ts"],
      "@fluent.xyz/connect": ["../../packages/connect/src/index.ts"],
      "@fluent.xyz/connect/internal/WalletMenuActionCard": [
        "../../packages/connect/src/components/WalletMenuActionCard.tsx"
      ],
      "@fluent.xyz/registry": ["../../packages/registry/src/index.ts"]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
