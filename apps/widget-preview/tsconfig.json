{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@fluent.xyz/connect-sdk": ["../../packages/connect-sdk/src/index.ts"],
      "@fluent.xyz/connect": ["../../packages/connect/src/index.ts"],
      "@fluent.xyz/connect/internal/WalletMenuActionCard": [
        "../../packages/connect/src/components/WalletMenuActionCard.tsx"
      ],
      "@fluent.xyz/connect/internal/reownAppKit": [
        "../../packages/connect/src/widget/reownAppKit.tsx"
      ],
      "@fluent.xyz/connect/internal/BridgeScreen": [
        "../../packages/connect/src/bridge/BridgeScreen.tsx"
      ],
      "@fluent.xyz/connect/internal/walletMenuSubPages": [
        "../../packages/connect/src/widget/walletMenuSubPages.ts"
      ],
      "@fluent.xyz/connect/internal/FluentAccountDrawer": [
        "../../packages/connect/src/widget/components/FluentAccountDrawer.tsx"
      ],
      "@fluent.xyz/connect/internal/drawer": [
        "../../packages/connect/src/components/ui/drawer.tsx"
      ],
      "@fluent.xyz/connect/internal/portalContainer": [
        "../../packages/connect/src/widget/portalContainer.tsx"
      ],
      "@fluent.xyz/connect/internal/ui/*": [
        "../../packages/connect/src/components/ui/*"
      ],
      "@fluent.xyz/registry": ["../../packages/registry/src/index.ts"]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
