{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "strict": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@fluent/react": ["../../packages/react/src/index.ts"],
      "@fluent/registry": ["../../packages/registry/src/index.ts"],
      "@fluent/connect-sdk": ["../../packages/connect-sdk/src/index.ts"],
      "@fluent/wallet-sdk": ["../../packages/wallet-sdk/src/index.ts"]
    },
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src"]
}
